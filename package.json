{
  "name": "chess-desktop",
  "private": true,
  "license": "MIT",
  "description": "Desktop client for Chess.com and Lichess",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @chess-desktop/desktop dev",
    "dev:web": "pnpm --filter @chess-desktop/web dev",
    "build:desktop": "pnpm --filter @chess-desktop/desktop build",
    "build:web": "pnpm --filter @chess-desktop/web build",
    "package:desktop": "pnpm --filter @chess-desktop/desktop package",
    "test": "vitest run",
    "test:e2e": "pnpm build:desktop && wdio run wdio.conf.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "^9.30.1",
    "@wdio/electron-service": "^10.2.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
